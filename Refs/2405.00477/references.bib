@article{Li2022,
abstract = {A realistic first-principle-based spin Hamiltonian is constructed for the type-II multiferroic NiI$_2$, using a symmetry-adapted cluster expansion method. Besides single ion anisotropy and isotropic Heisenberg terms, this model further includes the Kitaev interaction and a biquadratic term, and can well reproduce striking features of the experimental helical ground state, that are, {\it e.g.}, a proper screw state, canting of rotation plane, propagation direction and period. Using this model to build a phase diagram, it is demonstrated that, (i) the in-plane propagation direction of $\langle1\bar10\rangle$ is determined by the Kitaev interaction, instead of the long-believed exchange frustrations; and (ii) the canting of rotation plane is also dominantly determined by Kitaev interaction, rather than interlayer couplings. Furthermore, additional Monte Carlo simulations reveal three equivalent domains and different topological defects. Since the ferroelectricity is induced by spins in type-II multiferroics, our work also implies that Kitaev interaction is closely related to the multiferroicity of NiI$_2$.},
archivePrefix = {arXiv},
arxivId = {2211.14416},
author = {Li, Xuanyi and Xu, Changsong and Liu, Boyu and Li, Xueyang and Bellaiche, L. and Xiang, Hongjun},
doi = {10.1103/PhysRevLett.131.036701},
eprint = {2211.14416},
file = {:Users/tols/Library/Application Support/Mendeley Desktop/Downloaded/Li et al. - 2022 - Realistic Spin Model for Multiferroic NiI$_2$.pdf:pdf},
issn = {0031-9007},
journal = {Physical Review Letters},
month = {jul},
number = {3},
pages = {036701},
title = {{Realistic Spin Model for Multiferroic NiI$_2$}},
url = {http://arxiv.org/abs/2211.14416 https://link.aps.org/doi/10.1103/PhysRevLett.131.036701},
volume = {131},
year = {2023}
}

