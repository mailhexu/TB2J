eprint = {1902.00077},
file = {:Users/tols/Library/Application Support/Mendeley Desktop/Downloaded/Lee et al. - 2019 - Fundamental Spin Interactions Underlying the Magnetic Anisotropy in the Kitaev Ferromagnet CrI$_3$(2).pdf:pdf},
issn = {0031-9007},
journal = {Physical Review Letters},
keywords = {doi:10.1103/PhysRevLett.124.017201 url:https://doi},
mendeley-groups = {2D magnetism},
month = {jan},
number = {1},
pages = {017201},
publisher = {American Physical Society},
title = {{Fundamental Spin Interactions Underlying the Magnetic Anisotropy in the Kitaev Ferromagnet CrI$_3$}},
url = {http://arxiv.org/abs/1902.00077 https://link.aps.org/doi/10.1103/PhysRevLett.124.017201},
volume = {124},
year = {2020}
}

@article{Olsen2021,
abstract = {We present first principles calculations of the two-particle excitation spectrum of CrI$_3$ using many-body perturbation theory including spin-orbit coupling. Specifically, we solve the Bethe-Salpeter equation, which is equivalent to summing up all ladder diagrams with static screening and it is shown that excitons as well as magnons can be extracted seamlessly from the calculations. The resulting optical absorption spectrum as well as the magnon dispersion agree very well with recent measurements and we extract the amplitude for optical excitation of magnons resulting from spin-orbit interactions. Importantly, the results do not rely on any assumptions on the microscopic magnetic interactions such as Dzyaloshinskii-Moriya (DM), Kitaev or biquadratic interactions and we obtain a model independent estimate of the gap between acoustic and optical magnons of 0.3 meV. In addition, we resolve the magnon wavefunction in terms of band transitions and show that the magnon carries a spin that is significantly smaller than $\hbar$. This highlights the importance of terms that do not commute with $S^z$ in any Heisenberg model description.},
archivePrefix = {arXiv},
arxivId = {2107.02284},
author = {Olsen, Thomas},
doi = {10.1103/PhysRevLett.127.166402},
eprint = {2107.02284},
file = {:Users/tols/Papers/PhysRevLett.127.166402.pdf:pdf},
issn = {0031-9007},
journal = {Physical Review Letters},
keywords = {doi:10.1103/PhysRevLett.127.166402 url:https://doi},
month = {oct},
number = {16},
pages = {166402},
publisher = {American Physical Society},
title = {{Unified Treatment of Magnons and Excitons in Monolayer CrI$_3$ from Many-Body Perturbation Theory}},
url = {http://arxiv.org/abs/2107.02284 https://link.aps.org/doi/10.1103/PhysRevLett.127.166402},
volume = {127},
year = {2021}
}

