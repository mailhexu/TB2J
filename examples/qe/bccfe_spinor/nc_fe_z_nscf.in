&CONTROL
 calculation='nscf'
 prefix='nc_fe_z'
 outdir='./tmp_nc'
 pseudo_dir='./pseudo'
/
&SYSTEM
 ibrav=3
 celldm(1)=5.42
 nat=1
 ntyp=1
 ecutwfc=80
 ecutrho=320
 noncolin=.true.
 starting_magnetization(1)=0.4
 angle1(1)=0.0
